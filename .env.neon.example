# Neon connection strings for the make neon-* targets and NEON=1 make correct.
# Copy to .env.neon (never committed) and fill in from the Neon console.
# Direct (not pooled) connection, owner role:
NEON_DATABASE_URL=postgresql://<owner>:<password>@<endpoint>.us-east-1.aws.neon.tech/neondb?sslmode=require
